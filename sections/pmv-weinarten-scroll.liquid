<style>
.pmv-ws-driver {
  width: 100vw;
  position: relative;
  left: 50%; right: 50%;
  margin-left: -50vw; margin-right: -50vw;
  background: #faf4e8;
}
.pmv-ws-driver.is-overview { background: #4a1515; }

.pmv-ws {
  --cr:#faf4e8; --cr2:#f0e6cf; --wi:#4a1515; --wi2:#6d2a24;
  --go:#9b6a2f; --go2:#c49a4f; --tx:#2d1a17; --mu:#7a5245;
  --bo:rgba(155,106,47,.18);

  width: 100%;
  background: var(--cr);
  color: var(--tx);
  font-family: inherit;
}
.pmv-ws * { box-sizing: border-box; }

/* === Pin-States (JS managed) === */
.pmv-ws.pmv-js {
  height: 100vh;
  overflow: hidden;
  position: absolute;
  top: 0; left: 0; right: 0;
}
.pmv-ws.pmv-js.is-pinned {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1;
}
.pmv-ws.pmv-js.is-park-bottom {
  position: absolute;
  top: auto; bottom: 0; left: 0; right: 0;
}

/* === Steps: ohne JS = normal gestapelt === */
.pmv-ws-step {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  min-height: 80vh;
  width: 100%;
}
.pmv-ws-step--overview { background: var(--wi); }

/* === Steps: mit JS = absolut, animiert === */
.pmv-ws.pmv-js .pmv-ws-step {
  position: absolute;
  inset: 0;
  padding: 40px;
  min-height: unset;
  opacity: 0;
  pointer-events: none;
  transform: translateX(72px);
  transition: opacity .75s ease, transform .75s cubic-bezier(.22,1,.36,1);
}
.pmv-ws.pmv-js .pmv-ws-step[data-enter="left"] { transform: translateX(-72px); }
.pmv-ws.pmv-js .pmv-ws-step[data-enter="up"]   { transform: translateY(48px); }

/* Step 0 ist beim Page-Load aktiv (per HTML-Klasse) → keine Initial-Animation */
.pmv-ws.pmv-js .pmv-ws-step.pmv-step--active {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}
.pmv-ws.pmv-js .pmv-ws-step.pmv-step--before                       { opacity: 0; transform: translateX(-80px); }
.pmv-ws.pmv-js .pmv-ws-step[data-enter="left"].pmv-step--before    { opacity: 0; transform: translateX(80px); }
.pmv-ws.pmv-js .pmv-ws-step[data-enter="up"].pmv-step--before      { opacity: 0; transform: translateY(-48px); }

/* === Intro === */
.pmv-ws-intro { max-width: 740px; text-align: center; }
.pmv-ws-kicker { display: inline-block; color: var(--go); font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; margin-bottom: 18px; }
.pmv-ws-intro h2 { color: var(--wi); font-size: clamp(32px,5.2vw,60px); line-height: 1.02; font-weight: 700; margin: 0 0 18px; }
.pmv-ws-intro p { color: var(--mu); font-size: 17px; line-height: 1.72; max-width: 520px; margin: 0 auto 26px; }
.pmv-ws-ornament { width: 52px; height: 2px; background: linear-gradient(to right,transparent,var(--go),transparent); margin: 0 auto; }

/* === Weinart-Layout === */
.pmv-ws-item__inner {
  max-width: 1100px; width: 100%;
  display: grid; grid-template-columns: 400px 1fr;
  gap: 80px; align-items: center; padding: 0 44px;
}
.pmv-ws-item__inner--alt { grid-template-columns: 1fr 400px; }
.pmv-ws-item__inner--alt .pmv-ws-item__img  { order: 2; }
.pmv-ws-item__inner--alt .pmv-ws-item__text { order: 1; }
.pmv-ws-item__img, .pmv-ws-item__text { min-width: 0; }

.pmv-ws-item__img {
  position: relative; width: 100%;
  aspect-ratio: 2/3; border-radius: 22px; overflow: hidden;
  box-shadow: 0 3px 0 rgba(155,106,47,.1), 0 28px 70px rgba(74,21,21,.18);
}
.pmv-ws-item__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pmv-ws-item__img::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(155deg,rgba(74,21,21,.2),transparent 55%);
  pointer-events: none;
}
.pmv-ws-num {
  position: absolute; top: 18px; left: 18px; z-index: 2;
  width: 40px; height: 40px;
  background: rgba(250,244,232,.92); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 900; color: var(--wi);
  letter-spacing: .06em; box-shadow: 0 3px 12px rgba(0,0,0,.14);
}

.pmv-ws-item__label { display: inline-flex; align-items: center; gap: 10px; color: var(--go); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 16px; }
.pmv-ws-item__label::before { content: ""; flex-shrink: 0; width: 28px; height: 1.5px; background: currentColor; }
.pmv-ws-item__text h3 { color: var(--wi); font-size: clamp(34px,4vw,56px); line-height: 1.0; font-weight: 700; margin: 0 0 18px; letter-spacing: -.015em; word-break: break-word; }
.pmv-ws-item__text p { color: var(--mu); font-size: 17px; line-height: 1.7; margin: 0 0 30px; max-width: 100%; }
.pmv-ws-btn {
  display: inline-block; padding: 14px 32px;
  background: var(--wi); color: var(--cr) !important;
  text-decoration: none !important;
  font-weight: 700; font-size: 14px;
  border-radius: 999px; letter-spacing: .04em;
  box-shadow: 0 8px 24px rgba(74,21,21,.22);
  transition: background .25s, transform .25s, box-shadow .25s;
}
.pmv-ws-btn:hover { background: var(--wi2); transform: translateY(-3px); box-shadow: 0 14px 36px rgba(74,21,21,.3); }

/* === Übersicht === */
.pmv-ws-step--overview { background: var(--wi); overflow-y: auto; align-items: center; }
.pmv-ws-overview-inner { max-width: 1100px; width: 100%; padding: 0 44px; }
.pmv-ws-overview__head { text-align: center; margin-bottom: 36px; }
.pmv-ws-overview__head h2 { color: var(--cr); font-size: clamp(22px,3vw,38px); font-weight: 700; margin: 0 0 10px; line-height: 1.1; }
.pmv-ws-overview__head p { color: rgba(250,244,232,.72); font-size: 15px; max-width: 460px; margin: 0 auto; }

.pmv-ws-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
.pmv-ws-card {
  display: block; text-decoration: none !important;
  border-radius: 16px; overflow: hidden;
  background: rgba(255,255,255,.06); border: 1px solid rgba(250,244,232,.1);
  transition: transform .3s, box-shadow .3s, border-color .3s;
}
.pmv-ws-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,.3); border-color: rgba(250,244,232,.22); }
.pmv-ws-card__img { position: relative; aspect-ratio: 3/4; overflow: hidden; }
.pmv-ws-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
.pmv-ws-card:hover .pmv-ws-card__img img { transform: scale(1.06); }
.pmv-ws-card__body { padding: 14px 16px 18px; }
.pmv-ws-card__title { color: var(--cr); font-size: 15px; font-weight: 700; display: block; margin-bottom: 4px; }
.pmv-ws-card__cta { color: var(--go2); font-size: 12px; font-weight: 600; letter-spacing: .06em; display: inline-flex; align-items: center; gap: 4px; }
.pmv-ws-card__cta::after { content: "→"; transition: transform .2s; }
.pmv-ws-card:hover .pmv-ws-card__cta::after { transform: translateX(4px); }

/* === Fortschrittsbalken === */
.pmv-ws-progress {
  display: none;
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 3px; background: rgba(155,106,47,.15); z-index: 20;
}
.pmv-ws-progress__fill { height: 100%; background: var(--go); width: 0%; transition: width .4s ease; }
.pmv-ws.pmv-js .pmv-ws-progress { display: block; }

/* === Scroll Hint === */
.pmv-ws-hint {
  display: none;
  position: absolute; bottom: 18px; left: 50%;
  transform: translateX(-50%);
  color: var(--mu); font-size: 10px; font-weight: 800;
  letter-spacing: .2em; text-transform: uppercase;
  flex-direction: column; align-items: center; gap: 5px;
  transition: opacity .5s;
  animation: pmv-bounce 2s ease infinite;
}
.pmv-ws.pmv-js .pmv-ws-hint { display: flex; }
.pmv-ws-hint svg { width: 16px; height: 16px; opacity: .55; }
@keyframes pmv-bounce { 0%,100% { bottom: 18px; } 50% { bottom: 10px; } }

/* === Responsive === */
@media (max-width: 1080px) {
  .pmv-ws-item__inner { grid-template-columns: 340px 1fr; gap: 52px; padding: 0 28px; }
  .pmv-ws-item__inner--alt { grid-template-columns: 1fr 340px; }
}
@media (max-width: 820px) {
  .pmv-ws.pmv-js .pmv-ws-step { padding: 20px 16px; }
  .pmv-ws-item__inner, .pmv-ws-item__inner--alt { grid-template-columns: 1fr; gap: 16px; padding: 0; }
  .pmv-ws-item__inner--alt .pmv-ws-item__img  { order: 1; }
  .pmv-ws-item__inner--alt .pmv-ws-item__text { order: 2; }
  .pmv-ws-item__img { aspect-ratio: unset; height: 220px; border-radius: 14px; }
  .pmv-ws-item__text h3 { font-size: 26px; }
  .pmv-ws-item__text p  { font-size: 15px; margin-bottom: 20px; }
  .pmv-ws-grid { grid-template-columns: repeat(2,1fr); gap: 10px; }
  .pmv-ws-overview-inner { padding: 0 16px; }
}
@media (max-width: 420px) {
  .pmv-ws-grid { gap: 8px; }
  .pmv-ws-card__body { padding: 10px 12px 12px; }
  .pmv-ws-card__title { font-size: 13px; }
}
@media (prefers-reduced-motion: reduce) {
  .pmv-ws.pmv-js .pmv-ws-step { transition: none !important; }
  .pmv-ws-hint { animation: none !important; }
}
</style>

{%- liquid
  assign rot_col      = collections['rot-wein']
  assign weiss_col    = collections['weiss-wein']
  assign rose_col     = collections['rose']
  assign aperitif_col = collections['aperitif-sekt']
-%}

<div class="pmv-ws-driver" id="pmv-ws-driver">
<section class="pmv-ws" id="pmv-ws" aria-label="Weinarten Auswahl">

  <!-- 0 · Intro (initial aktiv) -->
  <div class="pmv-ws-step pmv-step--active" data-step="0" data-enter="up">
    <div class="pmv-ws-intro">
      <div class="pmv-ws-kicker">PM VINO Auswahl</div>
      <h2>Wählen Sie nach Ihrem Moment.</h2>
      <p>Entdecken Sie unsere Weinarten nicht wie in einem Regal, sondern als kleine Reise
         durch Genussmomente — vom kräftigen Rotwein bis zum Aperitif.</p>
      <div class="pmv-ws-ornament"></div>
    </div>
  </div>

  <!-- 1 · Rotwein -->
  <div class="pmv-ws-step" data-step="1" data-enter="left">
    <div class="pmv-ws-item__inner">
      <div class="pmv-ws-item__img">
        <span class="pmv-ws-num">01</span>
        {%- if rot_col.image -%}
          <img src="{{ rot_col.image | image_url: width: 900 }}" alt="Rotwein" loading="lazy" width="900" height="1350">
        {%- else -%}
          <img src="BILD-URL-ROTWEIN-HIER-ERSETZEN" alt="Rotwein" loading="lazy">
        {%- endif -%}
      </div>
      <div class="pmv-ws-item__text">
        <div class="pmv-ws-item__label">Weinart 01</div>
        <h3>Rotwein</h3>
        <p>Kräftig, warm und ideal zu Pasta, Fleisch, Käse und gemütlichen Abenden.</p>
        <a href="/collections/rot-wein" class="pmv-ws-btn">Rotweine entdecken</a>
      </div>
    </div>
  </div>

  <!-- 2 · Weißwein -->
  <div class="pmv-ws-step" data-step="2" data-enter="right">
    <div class="pmv-ws-item__inner pmv-ws-item__inner--alt">
      <div class="pmv-ws-item__img">
        <span class="pmv-ws-num">02</span>
        {%- if weiss_col.image -%}
          <img src="{{ weiss_col.image | image_url: width: 900 }}" alt="Weißwein" loading="lazy" width="900" height="1350">
        {%- else -%}
          <img src="BILD-URL-WEISSWEIN-HIER-ERSETZEN" alt="Weißwein" loading="lazy">
        {%- endif -%}
      </div>
      <div class="pmv-ws-item__text">
        <div class="pmv-ws-item__label">Weinart 02</div>
        <h3>Weißwein</h3>
        <p>Frisch, elegant und passend zu Fisch, Antipasti, Gemüse und leichter Küche.</p>
        <a href="/collections/weiss-wein" class="pmv-ws-btn">Weißweine entdecken</a>
      </div>
    </div>
  </div>

  <!-- 3 · Rosé -->
  <div class="pmv-ws-step" data-step="3" data-enter="left">
    <div class="pmv-ws-item__inner">
      <div class="pmv-ws-item__img">
        <span class="pmv-ws-num">03</span>
        {%- if rose_col.image -%}
          <img src="{{ rose_col.image | image_url: width: 900 }}" alt="Rosé" loading="lazy" width="900" height="1350">
        {%- else -%}
          <img src="BILD-URL-ROSE-HIER-ERSETZEN" alt="Rosé" loading="lazy">
        {%- endif -%}
      </div>
      <div class="pmv-ws-item__text">
        <div class="pmv-ws-item__label">Weinart 03</div>
        <h3>Rosé</h3>
        <p>Leicht, unkompliziert und perfekt für entspannte Momente und sonnige Tage.</p>
        <a href="/collections/rose" class="pmv-ws-btn">Rosé entdecken</a>
      </div>
    </div>
  </div>

  <!-- 4 · Aperitif & Sekt -->
  <div class="pmv-ws-step" data-step="4" data-enter="right">
    <div class="pmv-ws-item__inner pmv-ws-item__inner--alt">
      <div class="pmv-ws-item__img">
        <span class="pmv-ws-num">04</span>
        {%- if aperitif_col.image -%}
          <img src="{{ aperitif_col.image | image_url: width: 900 }}" alt="Aperitif & Sekt" loading="lazy" width="900" height="1350">
        {%- else -%}
          <img src="BILD-URL-APERITIF-HIER-ERSETZEN" alt="Aperitif & Sekt" loading="lazy">
        {%- endif -%}
      </div>
      <div class="pmv-ws-item__text">
        <div class="pmv-ws-item__label">Weinart 04</div>
        <h3>Aperitif & Sekt</h3>
        <p>Für den ersten Schluck des Abends, besondere Anlässe und stilvolles Anstoßen.</p>
        <a href="/collections/aperitif-sekt" class="pmv-ws-btn">Aperitif entdecken</a>
      </div>
    </div>
  </div>

  <!-- 5 · Übersicht -->
  <div class="pmv-ws-step pmv-ws-step--overview" data-step="5" data-enter="up">
    <div class="pmv-ws-overview-inner">
      <div class="pmv-ws-overview__head">
        <h2>Alle Weinarten auf einen Blick</h2>
        <p>Finden Sie schneller die passende Richtung — nach Geschmack, Anlass oder Gericht.</p>
      </div>
      <div class="pmv-ws-grid">

        <a href="/collections/rot-wein" class="pmv-ws-card">
          <div class="pmv-ws-card__img">
            {%- if rot_col.image -%}
              <img src="{{ rot_col.image | image_url: width: 600 }}" alt="Rotwein" loading="lazy" width="600" height="800">
            {%- else -%}
              <img src="BILD-URL-ROTWEIN-HIER-ERSETZEN" alt="Rotwein" loading="lazy">
            {%- endif -%}
          </div>
          <div class="pmv-ws-card__body">
            <span class="pmv-ws-card__title">Rotwein</span>
            <span class="pmv-ws-card__cta">Entdecken</span>
          </div>
        </a>

        <a href="/collections/weiss-wein" class="pmv-ws-card">
          <div class="pmv-ws-card__img">
            {%- if weiss_col.image -%}
              <img src="{{ weiss_col.image | image_url: width: 600 }}" alt="Weißwein" loading="lazy" width="600" height="800">
            {%- else -%}
              <img src="BILD-URL-WEISSWEIN-HIER-ERSETZEN" alt="Weißwein" loading="lazy">
            {%- endif -%}
          </div>
          <div class="pmv-ws-card__body">
            <span class="pmv-ws-card__title">Weißwein</span>
            <span class="pmv-ws-card__cta">Entdecken</span>
          </div>
        </a>

        <a href="/collections/rose" class="pmv-ws-card">
          <div class="pmv-ws-card__img">
            {%- if rose_col.image -%}
              <img src="{{ rose_col.image | image_url: width: 600 }}" alt="Rosé" loading="lazy" width="600" height="800">
            {%- else -%}
              <img src="BILD-URL-ROSE-HIER-ERSETZEN" alt="Rosé" loading="lazy">
            {%- endif -%}
          </div>
          <div class="pmv-ws-card__body">
            <span class="pmv-ws-card__title">Rosé</span>
            <span class="pmv-ws-card__cta">Entdecken</span>
          </div>
        </a>

        <a href="/collections/aperitif-sekt" class="pmv-ws-card">
          <div class="pmv-ws-card__img">
            {%- if aperitif_col.image -%}
              <img src="{{ aperitif_col.image | image_url: width: 600 }}" alt="Aperitif & Sekt" loading="lazy" width="600" height="800">
            {%- else -%}
              <img src="BILD-URL-APERITIF-HIER-ERSETZEN" alt="Aperitif & Sekt" loading="lazy">
            {%- endif -%}
          </div>
          <div class="pmv-ws-card__body">
            <span class="pmv-ws-card__title">Aperitif & Sekt</span>
            <span class="pmv-ws-card__cta">Entdecken</span>
          </div>
        </a>

      </div>
    </div>
  </div>

  <div class="pmv-ws-progress">
    <div class="pmv-ws-progress__fill" id="pmv-ws-fill"></div>
  </div>
  <div class="pmv-ws-hint" id="pmv-ws-hint">
    Scrollen
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>

</section>
</div>

<script>
(function () {
  var driver  = document.getElementById('pmv-ws-driver');
  var section = document.getElementById('pmv-ws');
  if (!driver || !section) return;

  var steps   = Array.prototype.slice.call(section.querySelectorAll('.pmv-ws-step'));
  var fill    = document.getElementById('pmv-ws-fill');
  var hint    = document.getElementById('pmv-ws-hint');
  var STEPS   = steps.length;
  var VH      = window.innerHeight;

  function setup() {
    VH = window.innerHeight;
    driver.style.height = (STEPS + 1) * VH + 'px';
  }

  setup();
  section.classList.add('pmv-js');

  var current  = 0;
  var pinState = '';

  function update() {
    var rect = driver.getBoundingClientRect();
    var driverH = driver.offsetHeight;
    var maxScroll = driverH - VH;
    var scrolled = Math.max(0, -rect.top);

    /* Pin-State */
    var newPin;
    if (rect.top >= 0)                newPin = 'top';
    else if (scrolled >= maxScroll)   newPin = 'bottom';
    else                              newPin = 'pin';

    if (newPin !== pinState) {
      pinState = newPin;
      section.classList.remove('is-pinned', 'is-park-bottom');
      if      (newPin === 'pin')    section.classList.add('is-pinned');
      else if (newPin === 'bottom') section.classList.add('is-park-bottom');
      /* 'top' = default (absolute, top:0) */
    }

    /* Active Step */
    var step = Math.min(Math.floor(scrolled / VH), STEPS - 1);
    if (step !== current) {
      current = step;
      for (var i = 0; i < steps.length; i++) {
        var el = steps[i];
        el.classList.remove('pmv-step--before', 'pmv-step--active');
        if      (i < step)   el.classList.add('pmv-step--before');
        else if (i === step) el.classList.add('pmv-step--active');
      }
      if (step === STEPS - 1) driver.classList.add('is-overview');
      else                    driver.classList.remove('is-overview');
    }

    if (fill) fill.style.width = (step / (STEPS - 1) * 100).toFixed(1) + '%';
    if (hint) hint.style.opacity = step >= STEPS - 1 ? '0' : '1';
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', function () { setup(); update(); });
  update();
})();
</script>
